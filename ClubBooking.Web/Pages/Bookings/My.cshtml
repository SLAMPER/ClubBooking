@page
@model ClubBooking.Web.Pages.Bookings.MyModel
@using ClubBooking.Web.Services
@{
    ViewData["Title"] = "Мои брони";
}

<h1 class="h3 mb-3">Мои брони</h1>

<partial name="_Messages" />

@if (Model.Bookings.Count == 0)
{
    <p class="text-muted">Броней пока нет. <a asp-page="/Index">Выбрать место</a></p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Место</th>
                    <th>Когда</th>
                    <th>Цена</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    var start = Model.Time.ToLocal(b.StartUtc);
                    var end = Model.Time.ToLocal(b.EndUtc);
                    <tr>
                        <td>@b.SeatNumber<br /><span class="text-muted">@b.ZoneName</span></td>
                        <td>@start.ToString("dd.MM.yyyy")<br /><span class="text-muted">с @start.ToString("HH:mm") до @end.ToString("HH:mm")</span></td>
                        <td>@b.Price.ToString("0.##") ₽</td>
                        <td>@ClubTime.StatusText(b.Status)</td>
                        <td class="text-end">
                            @if (b.CanCancel)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@b.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Отменить бронь можно не позже чем за 1 час до начала. Если не прийти в течение 15 минут после начала, бронь снимается.</p>
}
