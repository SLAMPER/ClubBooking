@page
@model IndexModel
@{
    ViewData["Title"] = "Карта мест";
}

<div class="cb-page-head">
    <h1>Карта мест</h1>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="cb-filter">
    <div class="cb-field">
        <label asp-for="Date" class="form-label">Дата</label>
        <input asp-for="Date" type="date" class="form-control" min="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Date?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="cb-field">
        <label asp-for="Time" class="form-label">Начало</label>
        <select asp-for="Time" class="form-select" asp-items="@(new SelectList(IndexModel.TimeOptions, Model.Time))"></select>
    </div>
    <div class="cb-field">
        <label asp-for="Hours" class="form-label">Длительность</label>
        <select asp-for="Hours" class="form-select">
            @for (var h = 1; h <= 5; h++)
            {
                <option value="@h" selected="@(h == Model.Hours)">@h ч</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Показать</button>
</form>

<div class="cb-map-meta">
    <p>
        Свободные места на @Model.StartLocal.ToString("dd.MM.yyyy") с @Model.StartLocal.ToString("HH:mm") до @Model.EndLocal.ToString("HH:mm").
        Нажмите на свободное место, чтобы увидеть цену и забронировать.
    </p>
    <ul class="cb-legend">
        <li><span class="cb-swatch is-free"></span>свободно</li>
        <li><span class="cb-swatch is-busy"></span>занято</li>
        <li><span class="cb-swatch is-closed"></span>закрыто</li>
        @if (User.IsInRole("client"))
        {
            <li><span class="cb-swatch is-mine"></span>ваша бронь</li>
        }
    </ul>
</div>

<div class="cb-layout">
    <div class="cb-rooms">
        @foreach (var zone in Model.Zones)
        {
            <section class="cb-room">
                <header class="cb-room-head">
                    <h2>@zone.Zone.Name</h2>
                    <div class="cb-rates">
                        <span class="cb-rate">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                            днём @zone.Zone.DayRate.ToString("0.##") ₽/ч
                        </span>
                        <span class="cb-rate">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
                            ночью (с 00:00 до 08:00) @zone.Zone.NightRate.ToString("0.##") ₽/ч
                        </span>
                    </div>
                </header>
                <div class="cb-floor">
                <div class="cb-seat-grid" style="grid-template-columns: repeat(@zone.Cols, var(--cb-seat-w)); grid-template-rows: repeat(@zone.Rows, var(--cb-seat-h));">
                    @foreach (var seat in zone.Seats)
                    {
                        var place = $"grid-row: {seat.Row}; grid-column: {seat.Col};";
                        if (!seat.IsActive)
                        {
                            <span class="cb-seat is-closed" style="@place" title="Закрыто на ремонт"><partial name="_SeatIcon" /><span>@seat.Number</span></span>
                        }
                        else if (Model.Mine.Contains(seat.Id))
                        {
                            <span class="cb-seat is-mine" style="@place" title="Ваша бронь"><partial name="_SeatIcon" /><span>@seat.Number</span></span>
                        }
                        else if (Model.Busy.Contains(seat.Id))
                        {
                            <span class="cb-seat is-busy" style="@place" title="Занято"><partial name="_SeatIcon" /><span>@seat.Number</span></span>
                        }
                        else
                        {
                            <a class="cb-seat is-free @(seat.Id == Model.Selected?.Id ? "is-selected" : "")" style="@place"
                               asp-page="/Index" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
                               asp-route-hours="@Model.Hours" asp-route-seat="@seat.Id" asp-fragment="booking"><partial name="_SeatIcon" /><span>@seat.Number</span></a>
                        }
                    }
                </div>
                </div>
            </section>
        }
    </div>

    <aside class="cb-ticket" id="booking">
        @if (Model.Selected == null)
        {
            <p class="cb-ticket-empty">Место не выбрано.</p>
        }
        else
        {
            <div class="cb-ticket-head">
                <h2>Место @Model.Selected.Number</h2>
                <span class="cb-ticket-zone">@Model.Selected.ZoneName</span>
            </div>
            <p class="cb-ticket-time">@Model.StartLocal.ToString("dd.MM.yyyy"), с @Model.StartLocal.ToString("HH:mm") до @Model.EndLocal.ToString("HH:mm")</p>
            @if (Model.PriceError != null)
            {
                <p class="cb-ticket-error">@Model.PriceError</p>
            }
            else
            {
                <p class="cb-ticket-price">Цена: <strong>@Model.Price?.ToString("0.##") ₽</strong></p>
                @if (User.IsInRole("client"))
                {
                    <form method="post" asp-page-handler="Book">
                        <input type="hidden" name="Date" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="Time" value="@Model.Time" />
                        <input type="hidden" name="Hours" value="@Model.Hours" />
                        <input type="hidden" name="Seat" value="@Model.Selected.Id" />
                        <button type="submit" class="btn btn-primary w-100">Забронировать</button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="cb-ticket-note">Бронировать могут только клиенты.</p>
                }
                else
                {
                    <a class="btn btn-outline-primary w-100" asp-page="/Account/Login" asp-route-returnUrl="@(Request.Path + Request.QueryString)">Войдите, чтобы забронировать</a>
                }
            }
        }
    </aside>
</div>
